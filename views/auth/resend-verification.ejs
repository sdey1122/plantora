<%- include("../partials/main/head", { title: "Resend Verification Email" }) %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card verification-card">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <div class="verification-icon success">

    <i class="bi bi-check-circle-fill"></i>

</div>

                    </div>

                    <h2 class="verification-title text-center">

    Resend Verification Email

</h2>

<p class="text-center text-muted mb-4">

    Enter the email address associated with your Plantora
    account and we'll send you a new verification email.

</p>

<% if (message) { %>

<div
    class="alert alert-<%= type === 'success' ? 'success' : 'danger' %>"
    role="alert"
>

    <%= message %>

</div>

<% } %>

<form
    class="verification-form"
    action="/auth/resend-verification-email"
    method="POST"
>

                        <div class="mb-4">

                            <label
                                for="email"
                                class="form-label"
                            >

                                Email Address

                            </label>

                            <input
    type="email"
    class="form-control form-control-lg"
    id="email"
    name="email"
    value="<%= email || '' %>"
    placeholder="Enter your email address"
    autocomplete="email"
    required
>

                        </div>

                        <div class="d-grid">

                            <button
                                type="submit"
                                class="btn btn-success btn-lg verification-btn"
                            >

                                <i class="bi bi-send me-2"></i>

                                Send Verification Email

                            </button>

                        </div>

                    </form>

                    <hr class="my-4">

                    <div class="d-grid gap-3">

                        <a
                            href="/?openLogin=true"
                            class="btn btn-outline-success"
                        >

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Back To Login

                        </a>

                        <a
                            href="/"
                            class="btn btn-outline-secondary"
                        >

                            <i class="bi bi-house-door me-2"></i>

                            Back To Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script src="public/js/header.js"></script>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script src="/js/featured.js"></script>

<script src="/js/why-choose.js"></script>

<script src="/js/notification.js"></script>

<script src="/js/footer.js"></script>

<script src="/js/auth.js"></script>

<script src="/js/verify.js"></script>