<%- include("../partials/main/head", { title }) %>

<%- include("../partials/main/header") %>

<main>

    <section class="py-5">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <div class="card auth-card shadow-sm border-0">

                        <div class="row g-0">

                            <!-- Left Panel -->

                            <div class="col-lg-5 auth-left">

                                <div class="auth-left-content">

                                    <h2>Create New Password</h2>

                                    <p>
                                        Choose a strong password to keep your
                                        Plantora account secure. Never reuse an
                                        old password.
                                    </p>

                                    <ul class="auth-features">

                                        <li>

                                            <i class="bi bi-shield-lock-fill"></i>

                                            Secure Password

                                        </li>

                                        <li>

                                            <i class="bi bi-key-fill"></i>

                                            Account Protection

                                        </li>

                                        <li>

                                            <i class="bi bi-check-circle-fill"></i>

                                            Instant Password Update

                                        </li>

                                    </ul>

                                </div>

                            </div>

                            <!-- Right Panel -->

                            <div class="col-lg-7">

                                <div class="auth-form-wrapper">

                                    <h3>Reset Password</h3>

                                    <p class="auth-subtitle">
                                        Enter and confirm your new password.
                                    </p>

                                    <div
                                        id="resetPasswordAlert"
                                        class="alert d-none"
                                    ></div>

                                    <form
                                        id="resetPasswordForm"
                                        novalidate
                                    >

                                        <!-- New Password -->

                                        <div class="mb-3">

                                            <label
                                                for="newPassword"
                                                class="form-label"
                                            >
                                                New Password
                                            </label>

                                            <div class="input-group">

                                                <input
                                                    type="password"
                                                    class="form-control"
                                                    id="newPassword"
                                                    name="password"
                                                    placeholder="Enter new password"
                                                    autocomplete="new-password"
                                                >

                                                <button
                                                    type="button"
                                                    class="btn btn-outline-secondary toggle-password"
                                                    data-target="newPassword"
                                                >

                                                    <i class="bi bi-eye"></i>

                                                </button>

                                            </div>

                                            <small
                                                class="text-danger"
                                                id="newPasswordError"
                                            ></small>

                                        </div>

                                        <!-- Password Strength -->

                                        <div class="password-strength mb-3">

                                            <div
                                                id="passwordStrengthBar"
                                                class="password-strength-bar"
                                            ></div>

                                            <small
                                                id="passwordStrengthText"
                                            >
                                                Password strength
                                            </small>

                                        </div>

                                        <!-- Confirm Password -->

                                        <div class="mb-4">

                                            <label
                                                for="confirmNewPassword"
                                                class="form-label"
                                            >
                                                Confirm Password
                                            </label>

                                            <div class="input-group">

                                                <input
                                                    type="password"
                                                    class="form-control"
                                                    id="confirmNewPassword"
                                                    name="confirmPassword"
                                                    placeholder="Confirm new password"
                                                    autocomplete="new-password"
                                                >

                                                <button
                                                    type="button"
                                                    class="btn btn-outline-secondary toggle-password"
                                                    data-target="confirmNewPassword"
                                                >

                                                    <i class="bi bi-eye"></i>

                                                </button>

                                            </div>

                                            <small
                                                class="text-danger"
                                                id="confirmNewPasswordError"
                                            ></small>

                                        </div>

                                        <!-- Submit -->

                                        <div class="d-grid">

                                            <button
                                                type="submit"
                                                class="btn btn-success auth-submit-btn"
                                                id="resetPasswordButton"
                                            >

                                                <span
                                                    id="resetPasswordButtonText"
                                                >
                                                    Reset Password
                                                </span>

                                                <span
                                                    id="resetPasswordSpinner"
                                                    class="spinner-border spinner-border-sm d-none"
                                                ></span>

                                            </button>

                                        </div>

                                    </form>

                                    <hr>

                                    <p class="text-center mb-0">

                                        Remember your password?

                                        <a href="/">

                                            Login

                                        </a>

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include("../partials/main/footer") %>

<script src="/js/resetPassword.js"></script>