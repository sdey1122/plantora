<%- include("../partials/main/head", { title: "Email Verified Successfully" }) %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card verification-card">

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <div class="verification-icon success">

    <i class="bi bi-check-circle-fill"></i>

</div>

                    </div>

                    <h2 class="verification-title">

                        Email Verified Successfully

                    </h2>

                    <p class="text-muted mb-4">

                        Your email address has been verified successfully.

                        You can now log in and start exploring Plantora.

                    </p>

                    <div
                        class="alert alert-success rounded-3"
                    >

                        Redirecting to the home page in

                        <strong>

                            <span id="countdown">

                                5

                            </span>

                        </strong>

                        seconds...

                    </div>

                    <div class="d-grid gap-3 mt-4">

                        <button
                            class="btn btn-success btn-lg verification-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#loginModal"
                        >

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Login Now

                        </button>

                        <a
                            href="/"
                            class="btn btn-outline-success btn-lg"
                        >

                            <i class="bi bi-house-door me-2"></i>

                            Go To Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

