<%- include("../partials/main/head", { title }) %>

<%- include("../partials/main/header") %>

<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card auth-card shadow-sm border-0">

                    <div class="row g-0">

                        <!-- Left Panel -->
                        <div class="col-lg-5 auth-left">

                            <div class="auth-left-content">

                                <h2>Forgot Password?</h2>

                                <p>
                                    No worries. Enter your registered email
                                    address and we'll send you a secure link
                                    to reset your password.
                                </p>

                                <ul class="auth-features">

                                    <li>
                                        <i class="bi bi-shield-lock-fill"></i>
                                        Secure Reset Link
                                    </li>

                                    <li>
                                        <i class="bi bi-envelope-fill"></i>
                                        Email Verification
                                    </li>

                                    <li>
                                        <i class="bi bi-clock-history"></i>
                                        Time Limited Access
                                    </li>

                                </ul>

                            </div>

                        </div>

                        <!-- Right Panel -->
                        <div class="col-lg-7">

                            <div class="auth-form-wrapper">

                                <h3>Reset Password</h3>

                                <p class="auth-subtitle">
                                    Enter your email to receive a password
                                    reset link.
                                </p>

                                <div
                                    id="forgotPasswordAlert"
                                    class="alert d-none"
                                ></div>

                                <form
                                    id="forgotPasswordForm"
                                    novalidate
                                >
                                                                    <!-- Email -->

                                    <div class="mb-4">

                                        <label
                                            for="forgotPasswordEmail"
                                            class="form-label"
                                        >
                                            Email Address
                                        </label>

                                        <input
                                            type="email"
                                            class="form-control"
                                            id="forgotPasswordEmail"
                                            name="email"
                                            placeholder="Enter your registered email"
                                            autocomplete="email"
                                        >

                                        <small
                                            class="text-danger"
                                            id="forgotPasswordEmailError"
                                        ></small>

                                    </div>

                                    <!-- Submit -->

                                    <div class="d-grid">

                                        <button
                                            type="submit"
                                            class="btn btn-success auth-submit-btn"
                                            id="forgotPasswordButton"
                                        >

                                            <span
                                                id="forgotPasswordButtonText"
                                            >
                                                Send Reset Link
                                            </span>

                                            <span
                                                id="forgotPasswordSpinner"
                                                class="spinner-border spinner-border-sm d-none"
                                            ></span>

                                        </button>

                                    </div>

                                </form>

                                <hr>

                                <p class="text-center mb-0">

                                    Remember your password?

                                    <a
                                        href="#"
                                        id="backToLogin"
                                        data-bs-toggle="modal"
                                        data-bs-target="#loginModal"
                                    >
                                        Login
                                    </a>

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<%- include("../partials/main/footer") %>