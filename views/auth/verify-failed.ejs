<%- include("../partials/main/head", { title: "Verification Failed" }) %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0 text-center verify-card">
                <div class="card-body p-5">

                    <i class="bi bi-x-circle-fill text-danger verify-icon"></i>

                    <h2 class="mt-4">
                        Verification Failed
                    </h2>

                    <p class="text-muted mt-3">
                        This verification link is invalid or has expired.
                        Please request a new verification email.
                    </p>

                    <div class="verify-actions d-grid gap-2 mt-4">
                        <form
    id="resendVerificationForm"
    class="verify-email-form"
>

    <div class="mb-3">

        <input
            type="email"
            class="form-control"
            id="email"
            placeholder="Enter your email"
            required
        >

        <small
            class="text-danger"
            id="emailError"
        ></small>

    </div>

    <button
        type="submit"
        class="btn btn-danger w-100"
        id="resendButton"
    >
        <span
            id="resendSpinner"
            class="spinner-border spinner-border-sm d-none me-2"
        ></span>

        <span id="resendButtonText">
            Resend Verification Email
        </span>
    </button>

</form>

                        <a
                            href="/"
                            class="btn btn-outline-secondary"
                        >
                            Go to Home
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div
    class="toast-container position-fixed top-0 end-0 p-3"
>

    <div
        id="verifyToast"
        class="toast"
        role="alert"
    >

        <div class="toast-header">

            <strong class="me-auto">
                Plantora
            </strong>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="toast"
            ></button>

        </div>

        <div
            class="toast-body"
            id="toastMessage"
        ></div>

    </div>

</div>

<%- include("../partials/main/footer") %>