<%- include("../partials/main/head", { title: "Email Verification Failed" }) %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card verification-card">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                       <div class="verification-icon error">

    <i class="bi bi-x-circle-fill"></i>

</div>

                    </div>

                    <h2 class="verification-title text-center">

                        Verification Failed

                    </h2>

                    <p class="text-center text-muted mb-4">

                        <%= message %>

                    </p>

                    <hr class="my-4">

                    <h5 class="fw-semibold mb-3">

                        Request a New Verification Email

                    </h5>

                    <p class="verification-description">

                        Enter the email address associated with your Plantora
                        account. We'll send you a new verification link.

                    </p>

                    <form
    class="verification-form"
    action="/auth/resend-verification-email"
    method="POST"
>

                        <div class="mb-4">

                            <label
                                for="email"
                                class="form-label"
                            >

                                Email Address

                            </label>

                            <input
                                type="email"
                                class="form-control form-control-lg"
                                id="email"
                                name="email"
                                placeholder="Enter your email address"
                                required
                                autocomplete="email"
                            >

                        </div>

                        <div class="d-grid">

                            <button
                                type="submit"
                                class="btn btn-success btn-lg verification-btn"
                            >

                                <i class="bi bi-envelope-paper me-2"></i>

                                Resend Verification Email

                            </button>

                        </div>

                    </form>

                    <div class="row mt-4">

                        <div class="col-md-6 mb-3 mb-md-0">

                            <a
                                href="/"
                                class="btn btn-outline-success w-100"
                            >

                                <i class="bi bi-house-door me-2"></i>

                                Home

                            </a>

                        </div>

                        <div class="col-md-6">

                            <a
                                href="/?openLogin=true"
                                class="btn btn-outline-secondary w-100"
                            >

                                <i class="bi bi-box-arrow-in-right me-2"></i>

                                Login

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script src="public/js/header.js"></script>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script src="/js/featured.js"></script>

<script src="/js/why-choose.js"></script>

<script src="/js/notification.js"></script>

<script src="/js/footer.js"></script>

<script src="/js/auth.js"></script>

<script src="/js/verify.js"></script>