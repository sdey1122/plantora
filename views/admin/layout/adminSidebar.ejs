<!-- ==========================================================
     ADMIN SIDEBAR
========================================================== -->

<aside class="admin-sidebar">
  <!-- ==========================================
         Logo
    =========================================== -->

  <div class="admin-sidebar-header">
    <a href="/" class="header-logo">
      <img
        src="/images/logo/plantora.png"
        alt="Plantora"
        class="admin-logo-image"
      />
    </a>
  </div>

  <!-- ==========================================
     Navigation
========================================== -->

  <nav class="admin-sidebar-nav">
    <ul>
      <!-- Dashboard -->

      <li>
        <a
          href="/admin/dashboard"
          class="<%= currentRoute === '/admin/dashboard' ? 'active' : '' %>"
        >
          <i class="bi bi-grid-1x2-fill"></i>

          <span>Dashboard</span>
        </a>
      </li>

      <!-- ===================================== -->
      <!-- USER MANAGEMENT -->
      <!-- ===================================== -->

      <li>
        <a
          href="/admin/users"
          class="<%= currentRoute.startsWith('/admin/users') && !currentRoute.startsWith('/admin/users/trash') ? 'active' : '' %>"
        >
          <i class="bi bi-people-fill"></i>

          <span>User Management</span>
        </a>
      </li>

      <li>
        <a
          href="/admin/users/trash"
          class="<%= currentRoute.startsWith('/admin/users/trash') ? 'active' : '' %>"
        >
          <i class="bi bi-trash3-fill"></i>

          <span>User Trash</span>
        </a>
      </li>

      <!-- ===================================== -->
      <!-- CATEGORY MANAGEMENT -->
      <!-- ===================================== -->

      <li>
        <a
          href="/admin/categories"
          class="<%= currentRoute.startsWith('/admin/categories') ? 'active' : '' %>"
        >
          <i class="bi bi-diagram-3-fill"></i>

          <span>Category Management</span>
        </a>
      </li>

      <!-- ===================================== -->
      <!-- BRAND MANAGEMENT -->
      <!-- ===================================== -->

      <li>
        <a
          href="/admin/brands"
          class="<%= currentRoute.startsWith('/admin/brands') ? 'active' : '' %>"
        >
          <i class="bi bi-award-fill"></i>

          <span>Brand Management</span>
        </a>
      </li>

      <!-- ===================================== -->
      <!-- PRODUCT MANAGEMENT -->
      <!-- ===================================== -->

      <li>
        <a
          href="/admin/products"
          class="<%= currentRoute.startsWith('/admin/products') && !currentRoute.startsWith('/admin/products/trash') ? 'active' : '' %>"
        >
          <i class="bi bi-box-seam-fill"></i>

          <span>Product Management</span>
        </a>
      </li>

      <li>
        <a
          href="/admin/products/trash"
          class="<%= currentRoute.startsWith('/admin/products/trash') ? 'active' : '' %>"
        >
          <i class="bi bi-trash-fill"></i>

          <span>Product Trash</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- ==========================================
         Footer
    =========================================== -->

  <div class="admin-sidebar-footer">
    <a href="/" target="_blank" class="sidebar-footer-link">
      <i class="bi bi-globe2"></i>

      <span> Visit Website </span>
    </a>

    <form action="/auth/logout" method="POST">
      <button type="submit" class="sidebar-logout-button">
        <i class="bi bi-box-arrow-right"></i>

        <span> Logout </span>
      </button>
    </form>
  </div>
</aside>
