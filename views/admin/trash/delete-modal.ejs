<!-- ==========================================================
     PERMANENT DELETE MODAL
========================================================== -->

<div
  class="modal fade"
  id="permanentDeleteModal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content premium-confirm-modal danger">
      <!-- Header -->

      <div class="premium-modal-header danger">
        <div class="modal-icon danger">
          <i class="bi bi-trash3-fill"></i>
        </div>

        <h3>Permanently Delete User</h3>

        <p>This action cannot be undone.</p>
      </div>

      <!-- Body -->

      <div class="modal-body text-center">
        <p id="permanentDeleteText" class="confirm-message">
          Delete this user permanently?
        </p>

        <div class="alert alert-danger mt-3">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>

          This will permanently remove the user account and all associated data
          from the system.
        </div>
      </div>

      <!-- Footer -->

      <div class="premium-modal-footer">
        <button
          type="button"
          class="btn btn-light premium-cancel-btn"
          data-bs-dismiss="modal"
        >
          <i class="bi bi-x-circle me-2"></i>

          Cancel
        </button>

        <form id="permanentDeleteForm" method="POST">
          <button type="submit" class="btn btn-danger premium-danger-btn">
            <i class="bi bi-trash3-fill me-2"></i>

            Delete Permanently
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
