<%- include("../layout/adminHeader", {
    pageTitle: "Create Brand",
    pageStyle: "brands"
}) %>

<div class="admin-wrapper">

    <%- include("../layout/adminSidebar") %>

    <div class="admin-main">

        <%- include("../layout/adminTopbar") %>

        <main class="admin-content">

            <!-- ========================================= -->
            <!-- PAGE HEADER -->
            <!-- ========================================= -->

            <section class="page-header-card">

                <div>

                    <h1>

                        <i class="bi bi-tags-fill"></i>

                        Create Brand

                    </h1>

                    <p>

                        Add a new product brand that can be assigned while creating products.

                    </p>

                </div>

                <a
                    href="/admin/brands"
                    class="btn btn-outline-secondary btn-lg"
                >

                    <i class="bi bi-arrow-left me-2"></i>

                    Back

                </a>

            </section>

            <!-- ========================================= -->
            <!-- FORM -->
            <!-- ========================================= -->

            <section class="form-card">

                <form
                    action="/admin/brands/create"
                    method="POST"
                    id="brandCreateForm"
                    autocomplete="off"
                    novalidate
                >

                    <div class="mb-4">

                        <label
                            for="brandName"
                            class="form-label fw-semibold"
                        >

                            Brand Name

                            <span class="text-danger">*</span>

                        </label>

                        <input
                            type="text"
                            id="brandName"
                            name="name"
                            class="form-control form-control-lg"
                            placeholder="Enter brand name"
                            maxlength="50"
                            required
                            autofocus
                        >

                        <div class="form-text">

                            Examples:
                            ABC Agriculture ,
                            XYZ Limited,
                            PQR Store...

                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="form-buttons">

                        <button
                            type="submit"
                            class="btn btn-success btn-lg"
                        >

                            <i class="bi bi-check-circle me-2"></i>

                            Create Brand

                        </button>

                        <a
                            href="/admin/brands"
                            class="btn btn-outline-secondary btn-lg"
                        >

                            Cancel

                        </a>

                    </div>

                </form>

            </section>

        </main>

    </div>

</div>

<%- include("../layout/adminFooter") %>