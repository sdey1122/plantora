<%
const query = new URLSearchParams();

if (search) {
    query.set("search", search);
}

if (sort) {
    query.set("sort", sort);
}

function pageLink(page) {
    const params = new URLSearchParams(query);
    params.set("page", page);

    return "/admin/brands?" + params.toString();
}

const startPage = Math.max(1, currentPage - 2);
const endPage = Math.min(totalPages, currentPage + 2);
%>

<% if (totalPages > 1) { %>

<div class="pagination-container">

    <!-- Pagination Information -->

    <div class="pagination-info">

        Showing

        <strong>
            <%= currentPage %>
        </strong>

        of

        <strong>
            <%= totalPages %>
        </strong>

        pages

        <span class="pagination-divider">
            |
        </span>

        Total Brands

        <strong>
            <%= totalBrands %>
        </strong>

    </div>


    <!-- Pagination -->

    <nav
        class="custom-pagination"
        aria-label="Brand pagination"
    >

        <ul class="pagination-list">

            <!-- First -->

            <li>

                <% if (currentPage === 1) { %>

                    <span class="page-button disabled">
                        <i class="bi bi-chevron-double-left"></i>
                    </span>

                <% } else { %>

                    <a
                        href="<%= pageLink(1) %>"
                        class="page-button"
                        title="First Page"
                    >
                        <i class="bi bi-chevron-double-left"></i>
                    </a>

                <% } %>

            </li>


            <!-- Previous -->

            <li>

                <% if (currentPage === 1) { %>

                    <span class="page-button disabled">
                        <i class="bi bi-chevron-left"></i>
                    </span>

                <% } else { %>

                    <a
                        href="<%= pageLink(currentPage - 1) %>"
                        class="page-button"
                        title="Previous Page"
                    >
                        <i class="bi bi-chevron-left"></i>
                    </a>

                <% } %>

            </li>


            <!-- Left Ellipsis -->

            <% if (startPage > 1) { %>

                <li>

                    <span class="page-dots">
                        ...
                    </span>

                </li>

            <% } %>


            <!-- Pages -->

            <% for (
                let page = startPage;
                page <= endPage;
                page++
            ) { %>

                <li>

                    <% if (page === currentPage) { %>

                        <span class="page-button active">
                            <%= page %>
                        </span>

                    <% } else { %>

                        <a
                            href="<%= pageLink(page) %>"
                            class="page-button"
                        >
                            <%= page %>
                        </a>

                    <% } %>

                </li>

            <% } %>


            <!-- Right Ellipsis -->

            <% if (endPage < totalPages) { %>

                <li>

                    <span class="page-dots">
                        ...
                    </span>

                </li>

            <% } %>


            <!-- Next -->

            <li>

                <% if (currentPage === totalPages) { %>

                    <span class="page-button disabled">
                        <i class="bi bi-chevron-right"></i>
                    </span>

                <% } else { %>

                    <a
                        href="<%= pageLink(currentPage + 1) %>"
                        class="page-button"
                        title="Next Page"
                    >
                        <i class="bi bi-chevron-right"></i>
                    </a>

                <% } %>

            </li>


            <!-- Last -->

            <li>

                <% if (currentPage === totalPages) { %>

                    <span class="page-button disabled">
                        <i class="bi bi-chevron-double-right"></i>
                    </span>

                <% } else { %>

                    <a
                        href="<%= pageLink(totalPages) %>"
                        class="page-button"
                        title="Last Page"
                    >
                        <i class="bi bi-chevron-double-right"></i>
                    </a>

                <% } %>

            </li>

        </ul>

    </nav>

</div>

<% } %>