<!-- ==========================================================
     HERO SECTION
========================================================== -->

<section class="hero-section">
  <div class="hero-background">
    <span class="hero-blob hero-blob-1"></span>

    <span class="hero-blob hero-blob-2"></span>

    <span class="hero-blob hero-blob-3"></span>
  </div>

  <div class="container">
    <div class="hero-wrapper">
      <!-- ==========================================
                 HERO CONTENT
            =========================================== -->

      <div class="hero-content">
        <span class="hero-subtitle">
          <i class="bi bi-flower1"></i>

          Nature Delivered To Your Doorstep
        </span>

        <h1 class="hero-title">
          Bring Nature Home With

          <span>Premium Indoor & Outdoor Plants</span>
        </h1>

        <p class="hero-description">
          Discover beautifully grown indoor plants, stylish pots, and gardening
          essentials carefully selected to transform your living space into a
          healthier, greener environment.
        </p>

        <div class="hero-actions">
          <a href="/shop" class="btn btn-primary hero-btn-primary">
            Shop Collection

            <i class="bi bi-arrow-right"></i>
          </a>

          <a href="/about" class="btn btn-outline-success hero-btn-secondary">
            Learn More
          </a>
        </div>

        <div class="hero-stats">
          <div class="hero-stat">
            <strong
              class="hero-counter"
              data-target="10000"
              data-suffix="K+"
              data-divisor="1000"
            >
              1K+
            </strong>

            <span>Happy Customers</span>
          </div>

          <div class="hero-stat">
            <strong>4.9★</strong>

            <span>Customer Rating</span>
          </div>

          <div class="hero-stat">
            <strong class="hero-counter" data-target="500" data-suffix="+">
              1+
            </strong>

            <span>Plant Varieties</span>
          </div>
        </div>
      </div>

      <!-- ==========================================
                 HERO IMAGE
            =========================================== -->

      <div class="hero-image">
        <div class="hero-image-wrapper">
          <div class="hero-glow"></div>

          <img
            src="/images/hero/hero-placeholder.png"
            alt="Premium Indoor Plant"
            class="hero-plant-image"
          />

          <span class="floating-card floating-card-1">
            <i class="bi bi-truck"></i>

            Free Shipping
          </span>

          <span class="floating-card floating-card-2">
            <i class="bi bi-patch-check-fill"></i>

            Premium Quality
          </span>

          <span class="floating-card floating-card-3">
            <i class="bi bi-stars"></i>

            Best Seller
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================
         SCROLL INDICATOR
    =========================================== -->

  <a href="#features" class="hero-scroll">
    <span>Scroll</span>

    <i class="bi bi-chevron-double-down"></i>
  </a>
</section>
