<%- include("../partials/main/head") %>

<%- include("../partials/main/announcementBar") %>

<%- include("../partials/main/header") %>


<main class="address-page">

  <div class="address-container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="address-page-header">

      <div>

        <span class="address-eyebrow">
          <i class="bi bi-geo-alt-fill"></i>
          Your Locations
        </span>

        <h1>
          Saved Addresses
        </h1>

        <p>
          Manage your delivery addresses for a faster checkout experience.
        </p>

      </div>

      <a
        href="/addresses/create"
        class="address-add-button"
      >
        <i class="bi bi-plus-lg"></i>
        Add New Address
      </a>

    </div>


    <!-- =====================================================
         STATS
    ====================================================== -->

    <div class="address-stats">

      <div class="address-stat">

        <div class="address-stat-icon">
          <i class="bi bi-house-heart"></i>
        </div>

        <div>

          <span>
            Saved Addresses
          </span>

          <strong>
            <%= totalAddresses %>
          </strong>

        </div>

      </div>


      <div class="address-stat">

        <div class="address-stat-icon">
          <i class="bi bi-shield-check"></i>
        </div>

        <div>

          <span>
            Maximum Allowed
          </span>

          <strong>
            10
          </strong>

        </div>

      </div>

    </div>


    <!-- =====================================================
         ADDRESS LIST
    ====================================================== -->

    <% if (!addresses || addresses.length === 0) { %>

      <div class="address-empty">

        <div class="address-empty-icon">
          <i class="bi bi-geo-alt"></i>
        </div>

        <h2>
          No saved addresses
        </h2>

        <p>
          Add your first delivery address to make checkout quick and easy.
        </p>

        <a
          href="/addresses/create"
          class="address-primary-button"
        >
          <i class="bi bi-plus-lg"></i>
          Add Your First Address
        </a>

      </div>

    <% } else { %>

      <div class="address-grid">

        <% addresses.forEach((address) => { %>

          <article
            class="address-card <%= address.isDefault ? 'is-default' : '' %>"
          >

            <!-- CARD TOP -->

            <div class="address-card-top">

              <div class="address-type">

                <span class="address-type-icon">

                  <% if (address.addressType === "office") { %>

                    <i class="bi bi-building"></i>

                  <% } else if (address.addressType === "other") { %>

                    <i class="bi bi-geo-alt"></i>

                  <% } else { %>

                    <i class="bi bi-house"></i>

                  <% } %>

                </span>

                <span>
                  <%= address.addressType %>
                </span>

              </div>


              <% if (address.isDefault) { %>

                <span class="default-badge">
                  <i class="bi bi-check-circle-fill"></i>
                  Default
                </span>

              <% } %>

            </div>


            <!-- NAME -->

            <div class="address-recipient">

              <h2>
                <%= address.fullName %>
              </h2>

              <p>
                <i class="bi bi-telephone"></i>

                <%= address.countryCode %>
                <%= address.phone %>
              </p>

            </div>


            <!-- ADDRESS -->

            <div class="address-card-content">

              <p>
                <%= address.addressLine1 %>
              </p>

              <% if (address.addressLine2) { %>

                <p>
                  <%= address.addressLine2 %>
                </p>

              <% } %>

              <% if (address.area) { %>

                <p>
                  <%= address.area %>
                </p>

              <% } %>

              <% if (address.landmark) { %>

                <p class="address-landmark">
                  <i class="bi bi-signpost-2"></i>
                  Near <%= address.landmark %>
                </p>

              <% } %>

              <p>
                <%= address.city %>,
                <%= address.state %>
                -
                <strong>
                  <%= address.postalCode %>
                </strong>
              </p>

              <p>
                <%= address.country %>
              </p>

            </div>


            <!-- ACTIONS -->

            <div class="address-card-actions">

              <a
                href="/addresses/<%= address._id %>/edit"
                class="address-action edit"
              >
                <i class="bi bi-pencil"></i>
                Edit
              </a>


              <% if (!address.isDefault) { %>

                <form
                  action="/addresses/<%= address._id %>/default"
                  method="POST"
                >

                  <button
                    type="submit"
                    class="address-action default"
                  >
                    <i class="bi bi-check2-circle"></i>
                    Make Default
                  </button>

                </form>

              <% } %>


              <form
                action="/addresses/<%= address._id %>/delete"
                method="POST"
                class="delete-address-form"
              >

                <button
                  type="submit"
                  class="address-action delete"
                >
                  <i class="bi bi-trash3"></i>
                  Delete
                </button>

              </form>

            </div>

          </article>

        <% }) %>

      </div>

    <% } %>


    <!-- =====================================================
         FOOTER ACTIONS
    ====================================================== -->

    <div class="address-bottom-actions">

      <a href="/addresses/trash">

        <i class="bi bi-trash3"></i>

        Deleted Addresses

      </a>

      <% if (totalPages > 1) { %>

        <div class="address-pagination">

          <% if (currentPage > 1) { %>

            <a
              href="/addresses?page=<%= currentPage - 1 %>"
              class="pagination-button"
            >
              <i class="bi bi-chevron-left"></i>
            </a>

          <% } %>


          <span>
            Page <strong><%= currentPage %></strong>
            of
            <strong><%= totalPages %></strong>
          </span>


          <% if (currentPage < totalPages) { %>

            <a
              href="/addresses?page=<%= currentPage + 1 %>"
              class="pagination-button"
            >
              <i class="bi bi-chevron-right"></i>
            </a>

          <% } %>

        </div>

      <% } %>

    </div>

  </div>

</main>


<%- include("../partials/main/footer") %>