# # Server
# PORT=5132
# NODE_ENV=development

# # App URL
# APP_URL=http://localhost:5132

# # Database
# MONGODB_URI=

# # JWT
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m

# JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN=7d

# SESSION_SECRET=

# # Cookies
# COOKIE_SECRET=

# COOKIE_ACCESS_TOKEN=accessToken
# COOKIE_REFRESH_TOKEN=refreshToken

# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# # Authentication
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION=24h

# BCRYPT_SALT_ROUNDS=12

# EMAIL_VERIFICATION_TOKEN_EXPIRES=1h
# RESET_PASSWORD_TOKEN_EXPIRES=15m

# # Admin
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# # Email
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=

# # Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# CLOUDINARY_FOLDER=green-nest

# DEFAULT_PROFILE_IMAGE_URL=

# # Redis
# REDIS_URL=

# # Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# # Upload
# MAX_FILE_SIZE=5242880
# MAX_PRODUCT_IMAGES=5
# MAX_REVIEW_IMAGES=5

# # Seller
# MAX_SELLER_PRODUCTS=1000

# # Pagination
# DEFAULT_PAGE_SIZE=10
# MAX_PAGE_SIZE=100

# Rate Limiter
# RATE_LIMIT_WINDOW_MS=900000

# REGISTER_RATE_LIMIT=5
# LOGIN_RATE_LIMIT=5

# FORGOT_PASSWORD_RATE_LIMIT=3
# RESET_PASSWORD_RATE_LIMIT=5

# RESEND_VERIFICATION_WINDOW_MS=3600000
# RESEND_VERIFICATION_RATE_LIMIT=5

# REFRESH_TOKEN_RATE_LIMIT=30

# PUBLIC_API_RATE_LIMIT=200
# ADMIN_API_RATE_LIMIT=100